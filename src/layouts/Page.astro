---
import {siteConfig as c} from '../data/siteConfig';
const {page,slug} = Astro.props;
const base=import.meta.env.BASE_URL;
const origin=c.origin?c.origin.replace(/\/$/,'')+'/':('https://aintgottaclue.github.io'+base);
const resolve=(s)=>s.replaceAll('{{BASE}}',base).replaceAll('{{BRAND}}',c.brand).replaceAll('{{PHONE_DISPLAY}}',c.phoneDisplay).replaceAll('{{PHONE_HREF}}',c.phoneHref);
const title=page.title||(slug==='index'?c.brand+' | Hydro Jetting':slug.replaceAll('-',' ')+' | '+c.brand);
const desc=page.description||'Hydro jetting information and service requests for Trotwood, Ohio.';
const HOODS={'neighborhood/westbrooke-village':'Westbrooke Village','neighborhood/shiloh-springs':'Shiloh Springs Road','neighborhood/main-street-corridor':'Main Street Corridor','neighborhood/salem-mall-wolf-creek':'Salem Mall and Wolf Creek Pike'};
const SVCS={'severe-grease-and-sludge':'Severe Grease and Sludge','tree-root-intrusions':'Tree Root Intrusions','recurring-clogs-and-slow-drains':'Recurring Clogs and Slow Drains','mineral-and-scale-deposits':'Mineral and Scale Deposits','preventative-maintenance':'Preventative Maintenance'};
const crumbs=[['Home',origin]];
if(HOODS[slug]){crumbs.push(['Neighborhoods',origin+'neighborhood/']);crumbs.push([HOODS[slug],origin+slug+'/']);}else if(SVCS[slug]){crumbs.push(['Services',origin+'services/']);crumbs.push([SVCS[slug],origin+slug+'/']);}
const areaName=HOODS[slug]?HOODS[slug]+', Trotwood, Ohio':'Trotwood, Ohio';
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':origin+'#organization',name:c.brand,url:origin,telephone:c.phoneDisplay,areaServed:{'@type':'City',name:'Trotwood, Ohio'}},{'@type':'WebPage',name:title,url:origin+(slug==='index'?'':slug+'/'),about:{'@id':origin+'#organization'}}]};
if(!['privacy','terms','contact','neighborhood'].includes(slug)) schema['@graph'].push({'@type':'Service',name:title,serviceType:'Hydro jetting information and requests',provider:{'@id':origin+'#organization'},areaServed:{'@type':HOODS[slug]?'Place':'City',name:areaName}});
if(crumbs.length>1) schema['@graph'].push({'@type':'BreadcrumbList',itemListElement:crumbs.map((x,i)=>({'@type':'ListItem',position:i+1,name:x[0],item:x[1]}))});
---
<!doctype html><html lang="en"><head><Fragment set:html={resolve(page.head)} /><link rel="icon" href={base+'favicon.svg'} type="image/svg+xml" /><title>{title}</title><meta name="description" content={desc} /><meta property="og:title" content={title} /><meta property="og:description" content={desc} /><link rel="canonical" href={origin+(slug==='index'?'':slug+'/')} /><meta property="og:url" content={origin+(slug==='index'?'':slug+'/')} /><meta property="og:image" content={origin+'assets/2d58a3356859246734.webp'} /><meta name="robots" content={base==='/'?'index,follow':'noindex,follow'} /><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />{c.ga4MeasurementId && <><script is:inline async src={'https://www.googletagmanager.com/gtag/js?id='+c.ga4MeasurementId}></script><script is:inline define:vars={{ga4:c.ga4MeasurementId}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4);</script></>}</head><body><Fragment set:html={resolve(['privacy','terms'].includes(slug) ? page.body.replace(/<img\b[^>]*>/gi, '') : page.body)} /><a style="background:#00d6ec!important;color:#071015!important" class="satellite-call sat-shimmer" href={'tel:'+c.phoneHref} data-phone aria-label={'Call '+c.brand+' at '+c.phoneDisplay}><span class="sat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{c.phoneDisplay}</span></a><script is:inline defer src={base+'assets/lead-form.js'}></script><script is:inline defer data-tracking-id={c.airchattyTrackingId} src="https://api.airchatty.com/js/external-tracking.js"></script><script is:inline defer src={base+'assets/interactions.js'}></script><style is:global>.satellite-call{position:fixed;bottom:18px;right:18px;background:#f2690d;color:white;padding:14px 20px;border-radius:7px;font-weight:700;z-index:80;box-shadow:0 4px 16px #0004}.lead-success{padding:30px;text-align:center}.lead-success[hidden]{display:none}.lead-success button{padding:12px;border:1px solid currentColor;margin-top:16px}body{padding-bottom:65px}button{cursor:pointer}.sat-mobile-panel{padding:16px;background:var(--color-primary,#0b1f3a);color:white;display:flex;flex-direction:column;gap:14px}.sat-mobile-panel[hidden]{display:none}.sat-mobile-panel a{color:white}html{scroll-behavior:smooth}</style></body></html>

<style is:global>.new-content-section{max-width:1280px;margin:auto;padding:64px 24px}.new-content-section h1{font-family:var(--font-display,inherit);font-size:clamp(32px,5vw,58px);font-weight:700;line-height:1.05;margin-bottom:25px}.new-content-section h2{font-size:28px;font-weight:700;margin:28px 0 15px}.new-content-section h3{font-size:21px;font-weight:700;margin:22px 0 12px}.new-content-section p,.new-content-section li{line-height:1.75;max-width:900px;margin:14px 0}.new-content-section ul,.new-content-section ol{padding-left:24px}.new-content-section a{color:var(--color-accent,var(--primary,#f2690d))}.new-content-section img{max-width:100%;max-height:480px;object-fit:cover;border-radius:12px}.new-content-section form{max-width:700px;padding:24px;border:1px solid #8885}.new-content-section label{display:block;margin:14px 0}.new-content-section input,.new-content-section textarea{display:block;width:100%;padding:12px;border:1px solid #8888;background:transparent;color:inherit}.new-content-section button{padding:12px 22px;background:#f2690d;color:white}.honeypot{position:absolute!important;width:1px!important;height:1px!important;clip-path:inset(50%)}.sat-desktop-nav{display:flex;gap:20px;align-items:center;font-size:14px;font-weight:600}.sat-desktop-nav details{position:relative}.sat-desktop-nav details div{position:absolute;top:100%;left:0;min-width:240px;padding:16px;background:#0b1f3a;color:white;box-shadow:0 6px 18px #0006;z-index:100;display:flex;flex-direction:column;gap:15px}.sat-desktop-nav summary{cursor:pointer}.sat-mobile-panel details div{display:flex;flex-direction:column;gap:14px;padding:12px}.sat-mobile-panel a{white-space:normal}@media(max-width:1023px){.sat-desktop-nav{display:none}}@media(min-width:1024px){[data-mobile-menu]{display:none}}</style>

<style is:global>form[data-lead-form]{min-width:0;max-width:100%;width:100%;padding:24px;display:flex;flex-direction:column;gap:12px}form[data-lead-form] label{display:flex;flex-direction:column;gap:7px;min-width:0}form[data-lead-form] input,form[data-lead-form] textarea{display:block;min-width:0;width:100%;padding:12px;border:1px solid #8887;border-radius:6px;background:transparent;color:inherit}form[data-lead-form] button[type=submit]{padding:14px;background:#f2690d;color:white;font-weight:700;border-radius:6px}form[data-lead-form] .honeypot{position:absolute!important;clip-path:inset(50%)}header{z-index:90}header a{flex-shrink:0}footer{overflow-wrap:anywhere}</style>

<style is:global>.satellite-call{background:#00d6ec;color:#071015}form[data-lead-form] button[type=submit]{background:#00d6ec;color:#071015}header nav{max-width:1280px;margin:auto;padding:20px 24px}.new-content-section a{color:#00d6ec}</style>

<style is:global>.sat-form{box-sizing:border-box}.sat-form label{margin:0!important}.sat-form input,.sat-form textarea{box-sizing:border-box}.sat-form small{display:block;font-size:12px;line-height:1.6}.sat-form [role=status]{white-space:normal}.sat-form .honeypot{position:absolute!important;left:-9999px!important;display:block!important;width:1px!important;height:1px!important}.sat-form:has(input){color:inherit}header .sat-desktop-nav{padding:0;margin:0}header .sat-desktop-nav>a,header .sat-desktop-nav summary{white-space:nowrap}.dark-mobile-toggle{display:none}.sat-mobile-panel{position:relative}@media(max-width:1023px){.dark-mobile-toggle{display:block}header .sat-desktop-nav{display:none}}.new-content-section form{width:100%}.new-content-section details{padding:15px;border-bottom:1px solid #8885}</style>

<style is:global>header{background:#0a0c10ed!important}header>nav{padding:0 24px!important}header{position:sticky!important}.sat-mobile-panel{background:#0a0c10}.sat-form{background:#10151c;border:1px solid #26323b;color:#e8eef2}.sat-form input,.sat-form textarea{background:#0a0c10}header .sat-desktop-nav details div{background:#10151c}</style>

<style is:global>@media(max-width:1023px){header a{flex-shrink:1;min-width:0}header [data-mobile-menu]{flex-shrink:0}header .font-display{font-size:20px;overflow-wrap:normal}.sat-mobile-panel{width:100%}}.sat-form input[aria-hidden=true]{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important}.sat-form textarea{min-height:110px}.sat-form input:not([aria-hidden=true]){min-height:45px}</style>

<style is:global>@media(max-width:1023px){header .font-display{font-size:18px!important;line-height:1.15!important}header .font-display+span{font-size:9px!important}header>div>div{min-width:0}header .flex.flex-row.items-center.justify-between{gap:8px!important}.sat-desktop-nav{display:none!important}.sat-mobile-panel{position:absolute!important;top:100%;left:0;right:0}}.satellite-call{background:#f2690d!important;color:#fff!important;position:fixed!important;bottom:18px!important;right:18px!important;z-index:80!important}</style>

<style is:global>.satellite-call{background:#00d6ec!important;color:#071015!important}form[data-lead-form] button[type=submit]{background:#00d6ec!important;color:#071015!important}</style>

<style is:global>.inline-content-link{display:inline-block;margin:5px 16px 5px 0;color:#f2690d}.new-content-section{padding-top:40px;padding-bottom:40px}</style>

<style is:global>.sat-sticky-call{background:#00d6ec!important;color:#050c12!important}.inline-content-link{color:#00d6ec!important}</style>

<style is:global>.satellite-call{background:#00d6ec!important;color:#071015!important}</style>

<style is:global>
.sat-shimmer{position:relative;overflow:hidden}
.sat-shimmer::before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 28%,rgba(255,255,255,.5) 50%,transparent 72%);transform:translate(-140%);animation:fabShine 2.4s ease-in-out infinite;pointer-events:none;z-index:1}
.sat-shimmer>*{position:relative;z-index:2}
.sat-ico{display:inline-flex;align-items:center;justify-content:center;animation:fabRing 1.4s ease-in-out infinite}
@keyframes fabShine{0%{transform:translate(-140%)}55%{transform:translate(140%)}to{transform:translate(140%)}}
@keyframes fabRing{0%,75%,to{transform:rotate(0)}10%{transform:rotate(-12deg)}20%{transform:rotate(12deg)}30%{transform:rotate(-10deg)}40%{transform:rotate(10deg)}50%{transform:rotate(0)}}
@media(prefers-reduced-motion:reduce){.sat-shimmer::before{animation:none;display:none}.sat-ico{animation:none}}
.satellite-call{display:inline-flex!important;align-items:center;gap:10px;border-radius:2px!important;font-family:var(--font-mono,ui-monospace,monospace);text-transform:uppercase;letter-spacing:.08em;font-size:13px}
.sat-topbar{background:#00d6ec;color:#071015}.sat-topbar a{color:#071015}
.sat-nav-call{display:inline-flex;align-items:center;gap:8px;background:#00d6ec;color:#071015;font-family:var(--font-mono,ui-monospace,monospace);font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;padding:10px 16px;border-radius:2px}
.sat-nav-call:hover{filter:brightness(1.08)}
header .sat-desktop-nav{gap:18px;font-size:13px}
.sat-pill{display:inline-block;border:1px solid #26323b;padding:12px 18px;border-radius:2px;color:inherit;font-size:14px}.sat-pill:hover{border-color:#00d6ec;color:#00d6ec}
.sat-mobile-panel .sat-nav-call{justify-content:center;color:#071015}
header{top:0}
@media(max-width:1023px){.sat-topbar p{display:none}.sat-topbar .flex{justify-content:center}}
</style>
<style is:global>.sat-grid{display:grid;gap:1px;background:#26323b;border:1px solid #26323b}.sat-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.sat-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:767px){.sat-grid-3,.sat-grid-2{grid-template-columns:1fr}}.sat-desktop-nav summary{list-style:none}.sat-desktop-nav summary::-webkit-details-marker{display:none}.sat-desktop-nav summary::after{content:"";display:inline-block;margin-left:6px;width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px)}.sat-mobile-panel summary{list-style:none}.sat-mobile-panel summary::-webkit-details-marker{display:none}</style>

<style is:global>
/* Success replaces the form only after a confirmed tracker response. */
[hidden]{display:none!important}
[data-lead-form][hidden],.lead-success[hidden]{display:none!important}
.lead-success{outline:none;text-align:center}
.lead-success svg{display:block;margin:0 auto 20px;color:#16a34a}
.lead-success h2{font-size:clamp(24px,4vw,32px);font-weight:700;line-height:1.2;margin:0 0 20px}
.lead-success p{line-height:1.65;margin:0 auto 24px;max-width:34em}
.lead-success .lead-success__again{background:none;border:0;border-radius:0;padding:0;margin-top:8px;font:inherit;font-weight:700;color:inherit;text-decoration:underline;text-underline-offset:4px;cursor:pointer}

/* Empty template toast host must not enlarge the mobile viewport. */
ol.fixed:empty{display:none!important}
</style>
<style is:global>
/* Keep footer pills inside the viewport so the fixed call button stays in view. */
.sat-pill{max-width:100%;white-space:normal;overflow-wrap:anywhere}
footer .sat-pill{display:inline-block;margin-bottom:8px}
html,body{overflow-x:clip}
</style>
<style is:global>.flex.flex-wrap:has(>.sat-pill){flex-wrap:wrap!important}</style>

<style is:global>.request-form-card{max-width:700px}.new-content-section ul{list-style:disc}.new-content-section form{box-sizing:border-box}form[data-lead-form]{box-sizing:border-box}</style>

<style is:global>#request-form,#contact{scroll-margin-top:150px}.new-content-section h2{overflow-wrap:break-word}</style>

<style is:global>.sat-mobile-panel{background:#0a0c10!important}.sat-mobile-panel a,.sat-mobile-panel summary{color:#e8eef2}.sat-mobile-panel .sat-nav-call{color:#071015}@media(min-width:1024px){header .sat-desktop-nav{gap:14px;font-size:12px}}</style>

<style is:global>
/* Mobile menu sits above fixed call CTAs. Icons track aria-expanded. */
header:has([aria-expanded="true"]){z-index:2001!important}
.mobile-menu-x{display:none!important}
[aria-expanded="true"]>.mobile-menu-hamburger{display:none!important}
[aria-expanded="true"]>.mobile-menu-x{display:block!important}
.mobile-menu-hamburger,.mobile-menu-x{flex:none;vertical-align:middle}
/* Menu icons: no square around hamburger/X. */
button[data-menu-toggle],button[data-menu],button[data-burger],button[data-mobile-menu],button.menu,button.menu-toggle,button.menu-btn,button.burger,.menu-toggle,.menu-btn,.burger{border:0!important;border-radius:0!important;box-shadow:none!important;background:transparent!important;outline:0}
button[data-menu-toggle]:focus-visible,button[data-menu]:focus-visible,button[data-mobile-menu]:focus-visible,button[data-burger]:focus-visible,button.menu:focus-visible,button.menu-toggle:focus-visible,button.menu-btn:focus-visible,button.burger:focus-visible{outline:2px solid currentColor!important;outline-offset:4px}
button[data-menu-toggle],button[data-menu],button[data-burger],button[data-mobile-menu],button.menu{min-width:44px;min-height:44px;align-items:center;justify-content:center}
button[data-menu-toggle]:focus-visible,button[data-menu]:focus-visible,button[data-mobile-menu]:focus-visible,button[data-burger]:focus-visible,button.menu:focus-visible{outline:2px solid currentColor;outline-offset:4px}
.mobile-nav,.sat-mobile-panel,#mobile-menu,.mobile-panel{max-height:calc(100dvh - 100px);overflow-y:auto;overscroll-behavior:contain}
@media(max-width:1100px){header:has([aria-expanded="true"]){position:sticky;top:0}}

</style>

<style is:global>.nh-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.nh-card,.nh-faq article{border:1px solid #26323b;border-radius:12px;padding:24px}.nh-card{display:block}.nh-faq{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.nh-pills{display:flex;gap:12px;flex-wrap:wrap}.nh-pills a{padding:12px 20px;border:1px solid #26323b;border-radius:999px}@media(max-width:700px){.nh-grid,.nh-faq{grid-template-columns:1fr}}</style>

<style is:global>.nh-hero-shell{display:grid;grid-template-columns:minmax(0,2fr) minmax(320px,1fr);max-width:1280px;margin:0 auto;padding:40px 24px;gap:40px}.nh-hero-shell>.new-content-section{padding:20px 0;width:100%;min-width:0}.nh-hero-form{padding:20px 0;min-width:0}.nh-hero-form h2{font-size:24px;font-weight:700;line-height:1.3;margin-bottom:16px}.nh-hero-form p{font-size:15px;line-height:1.65;margin-bottom:15px}@media(max-width:850px){.nh-hero-shell{grid-template-columns:1fr;gap:24px;padding:32px 24px}.nh-hero-form{padding:0}}</style>

<style is:global>.nh-hero-shell>.new-content-section{align-self:start;min-height:0!important;display:block!important;padding-top:20px!important;padding-bottom:20px!important}.nh-hero-shell{align-items:start}</style>
